{
  "schemaVersion": 1,
  "id": "kleeslabs",
  "version": "${version}",

  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "BlayTheNinth"
  ],
  "contact": {
    "homepage": "${homepage}",
    "sources": "${sources}",
    "issues": "${issues}"
  },

  "license": "${license}",
  "icon": "kleeslabs.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "net.blay09.mods.kleeslabs.fabric.FabricKleeSlabs"
    ],
    "client": [
      "net.blay09.mods.kleeslabs.fabric.client.FabricKleeSlabsClient"
    ],
    "fabric-datagen": [
      "net.blay09.mods.kleeslabs.fabric.datagen.ModDataGenerator"
    ]
  },
  "mixins": [
    "kleeslabs.mixins.json",
    "kleeslabs.fabric.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "balm-fabric": ">=${balm_version}",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=${java_version}"
  },
  "suggests": {
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/VAfZ2Nau6j"
      }
    }
  }
}
